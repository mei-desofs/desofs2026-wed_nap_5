    {
      "name": "resources",
      "item": [
        {
          "name": "Upload Resource",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let response;\r",
                  "\r",
                  "if (pm.response.headers.get(\"Content-Type\")?.includes(\"application/json\")) {\r",
                  "\r",
                  "    response = pm.response.json();\r",
                  "\r",
                  "    if (response && response.id) {\r",
                  "        pm.collectionVariables.set(\"resourceId\", response.id);\r",
                  "    } else {\r",
                  "        pm.collectionVariables.unset(\"resourceId\");\r",
                  "    }\r",
                  "\r",
                  "} else {\r",
                  "    console.log(\"Not JSON:\", pm.response.text());\r",
                  "    pm.collectionVariables.unset(\"resourceId\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "updloadFiles-models/fileUpload.txt"
                }
              ]
            },
            "url": {
